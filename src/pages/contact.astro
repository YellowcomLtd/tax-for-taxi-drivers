---
export const prerender = true;
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import ContactEnquiryForm from '../components/ContactEnquiryForm';
import shopfrontPhoto from '../assets/images/contact-shopfront.jpg';
import { SITE_URL } from '../lib/seo';

const contacts = [
  { label: 'Michael', value: '07799 414972', href: 'tel:07799414972' },
  { label: 'Cathy', value: '07366 565000', href: 'tel:07366565000' },
  { label: 'Office', value: '02890 132083', href: 'tel:02890132083' },
  { label: 'Email', value: 'info@taxfortaxidrivers.co.uk', href: 'mailto:info@taxfortaxidrivers.co.uk' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact Tax for Taxi Drivers',
  url: `${SITE_URL}/contact`,
  description:
    'Contact Tax for Taxi Drivers in Belfast for Self Assessment, Making Tax Digital and HMRC help.',
  mainEntity: { '@id': `${SITE_URL}/#business` },
};
---

<BaseLayout
  title="Contact us — Belfast office"
  description="Contact Tax for Taxi Drivers in Belfast. Call, email or visit Unit 4, North City Business Centre, 2 Duncairn Gardens, BT15 2GG. Self Assessment and tax help for taxi drivers."
  jsonLd={jsonLd}
>
  <section class="section intro">
    <div class="wrap intro-grid">
      <div class="rv">
        <span class="eyebrow">Get in touch</span>
        <h1>We minimise your tax and maximise your benefits.</h1>
        <p class="lead">
          Ring, email, or drop by the office. We'll talk through what we can do for you and give you a clear idea of the fees.
        </p>
      </div>
      <div class="rv photo-frame">
        <Image
          src={shopfrontPhoto}
          alt="The Tax for Taxi Drivers shopfront at Unit 4, North City Business Centre, Belfast"
          width={768}
          height={1024}
        />
      </div>
    </div>
  </section>

  <section class="section details">
    <div class="wrap details-grid">
      <div class="rv card">
        <h2>Visit us</h2>
        <address>
          Unit 4, North City Business Centre<br />
          2 Duncairn Gardens<br />
          Belfast<br />
          BT15 2GG
        </address>
        <a
          class="map-link"
          href="https://www.google.com/maps/search/?api=1&query=Unit+4+North+City+Business+Centre+2+Duncairn+Gardens+Belfast+BT15+2GG"
          target="_blank"
          rel="noopener noreferrer"
        >
          Open in Google Maps
        </a>
      </div>

      <div class="rv card">
        <h2>Contact details</h2>
        <ul class="contact-list">
          {contacts.map((item) => (
            <li>
              <span class="label">{item.label}</span>
              <a href={item.href}>{item.value}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section enquiry" id="enquiry">
    <div class="wrap enquiry-grid">
      <div class="rv enquiry-intro">
        <span class="eyebrow">General enquiry</span>
        <h2>Send us a message</h2>
        <p>
          Prefer to write? Use the form and we’ll get back to you. For urgent matters, phone the office —
          we still like speaking face to face.
        </p>
      </div>
      <div class="rv enquiry-panel">
        <ContactEnquiryForm client:load />
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .intro-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 48px;
    align-items: center;
  }

  .intro h1 {
    font-size: clamp(34px, 5vw, 54px);
    margin: 14px 0 12px;
    max-width: 18ch;
  }

  .intro .lead {
    font-size: 18px;
    color: var(--ink-2);
    max-width: 42ch;
    font-weight: 500;
  }

  .photo-frame :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: center center;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
  }

  .details {
    padding-top: 0;
  }

  .details-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .card {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 28px 26px;
  }

  .card h2 {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 16px;
  }

  address {
    font-style: normal;
    font-size: 17px;
    font-weight: 600;
    color: var(--ink);
    line-height: 1.55;
  }

  .map-link {
    display: inline-block;
    margin-top: 18px;
    font-weight: 800;
    font-size: 14px;
    border-bottom: 1.5px solid var(--yellow-deep);
  }

  .contact-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .contact-list li {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .contact-list .label {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .contact-list a {
    font-size: 18px;
    font-weight: 800;
    color: var(--ink);
  }

  .contact-list a:hover {
    color: var(--ink);
    border-bottom: 1.5px solid var(--yellow-deep);
    align-self: start;
  }

  .enquiry {
    padding-top: 0;
  }

  .enquiry-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 40px;
    align-items: start;
  }

  .enquiry-intro h2 {
    font-size: clamp(28px, 4vw, 40px);
    margin: 12px 0 12px;
  }

  .enquiry-intro p {
    color: var(--ink-2);
    font-size: 17px;
    font-weight: 500;
    max-width: 36ch;
  }

  .enquiry-panel {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 28px 26px;
    box-shadow: var(--shadow);
  }

  .enquiry-panel :global(.enquiry-form) {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .enquiry-panel :global(.enquiry-row) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  .enquiry-panel :global(.enquiry-field) {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .enquiry-panel :global(.enquiry-field label) {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .enquiry-panel :global(.enquiry-field .optional) {
    text-transform: none;
    letter-spacing: 0;
    font-weight: 600;
    color: var(--ink-3);
  }

  .enquiry-panel :global(.enquiry-field input),
  .enquiry-panel :global(.enquiry-field textarea) {
    font: inherit;
    font-size: 16px;
    font-weight: 500;
    color: var(--ink);
    background: var(--paper);
    border: 1.5px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 12px 14px;
    width: 100%;
  }

  .enquiry-panel :global(.enquiry-field input:focus),
  .enquiry-panel :global(.enquiry-field textarea:focus) {
    outline: 2px solid var(--yellow);
    outline-offset: 1px;
    border-color: var(--yellow-deep);
  }

  .enquiry-panel :global(.enquiry-field textarea) {
    resize: vertical;
    min-height: 120px;
  }

  .enquiry-panel :global(.enquiry-consent) {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font-size: 14px;
    font-weight: 500;
    color: var(--ink-2);
    line-height: 1.45;
  }

  .enquiry-panel :global(.enquiry-consent input) {
    margin-top: 3px;
    width: 18px;
    height: 18px;
    accent-color: var(--yellow-deep);
    flex: none;
  }

  .enquiry-panel :global(.enquiry-consent a) {
    font-weight: 800;
    color: var(--ink);
    border-bottom: 1.5px solid var(--yellow-deep);
  }

  .enquiry-panel :global(.enquiry-hp) {
    position: absolute;
    left: -9999px;
    height: 0;
    overflow: hidden;
  }

  .enquiry-panel :global(.enquiry-alert) {
    padding: 12px 14px;
    border-radius: var(--radius-sm);
    font-size: 14.5px;
    font-weight: 600;
  }

  .enquiry-panel :global(.enquiry-alert-error) {
    background: #fdecea;
    color: #8a1f11;
    border: 1px solid #f5c6c0;
  }

  .enquiry-panel :global(.enquiry-alert-ok) {
    background: #eaf7ee;
    color: #1d5c32;
    border: 1px solid #b7e0c2;
  }

  .enquiry-panel :global(.btn) {
    align-self: start;
  }

  @media (max-width: 860px) {
    .intro-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .photo-frame :global(img) {
      aspect-ratio: 4 / 3;
      object-position: center 35%;
    }

    .enquiry-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }

  @media (max-width: 720px) {
    .details-grid {
      grid-template-columns: 1fr;
    }

    .enquiry-panel :global(.enquiry-row) {
      grid-template-columns: 1fr;
    }
  }
</style>
