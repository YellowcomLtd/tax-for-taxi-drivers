---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCards from '../components/ServiceCards.astro';
import PricingTable from '../components/PricingTable.astro';
import CtaBand from '../components/CtaBand.astro';
---

<BaseLayout
  title="Services & fees"
  description="Self Assessment, benefit claims, HMRC investigations and more for self-employed taxi drivers. Fixed monthly fees on Bronze, Silver and Gold plans."
>
  <section class="section">
    <div class="wrap">
      <span class="eyebrow rv">What we do</span>
      <h1 class="rv">Everything a self-employed driver needs.</h1>
      <p class="rv lead">From your first HMRC registration to a full benefit entitlement check, handled by people who've done it for a decade.</p>
      <ServiceCards />
    </div>
  </section>

  <section class="section fees">
    <div class="wrap">
      <div class="head-row">
        <div class="rv"><span class="eyebrow">Simple, fixed fees</span><h2 style="margin-top: 12px">Clear pricing. Paid monthly.</h2></div>
        <p class="rv">No hourly surprises. Pick the plan that fits where you are, and pay by direct debit.</p>
      </div>
      <PricingTable />
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  h1 {
    font-size: clamp(34px, 5vw, 54px);
    margin: 14px 0 12px;
    max-width: 20ch;
  }

  .lead {
    font-size: 18px;
    color: var(--ink-2);
    max-width: 55ch;
    font-weight: 500;
  }

  .fees {
    background: var(--paper-2);
  }
</style>
