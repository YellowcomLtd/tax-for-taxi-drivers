---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import shopfront from '../assets/images/shopfront.jpg';
import teamPhoto from '../assets/images/office-team-1.jpg';
import consultPhoto from '../assets/images/office-consult-3.jpg';
import michaelBio from '../assets/images/michael-bio.jpg';

const stats = [
  { value: '10+', label: 'Years helping Belfast drivers with tax' },
  { value: '3,000+', label: 'Tax returns submitted successfully' },
  { value: '1st', label: 'Accountancy practice in NI to help clients claim Universal Credit' },
];
---

<BaseLayout
  title="About us"
  description="Tax for Taxi Drivers was set up by Michael, a Belfast accountant who was a taxi driver for 10 years. Over 3,000 tax returns submitted successfully."
>
  <section class="section intro">
    <div class="wrap intro-grid">
      <div class="rv">
        <span class="eyebrow">About us</span>
        <h1>A Belfast accountant who was a taxi driver.</h1>
        <p class="lead">
          Tax for Taxi Drivers was set up by Michael who was a taxi driver for 10 years. The goal was to do one thing:
          take the stress out of tax returns and make tax easy. We have 10 years' experience of preparing tax returns
          and have submitted more than 3,000 successfully.
        </p>
      </div>
      <div class="rv photo-frame feature">
        <Image
          src={michaelBio}
          alt="Michael, founder of Tax for Taxi Drivers"
          width={1024}
          height={680}
        />
      </div>
    </div>
  </section>

  <section class="stats">
    <div class="wrap stats-grid">
      {stats.map((stat) => (
        <div class="rv stat">
          <div class="stat-value">{stat.value}</div>
          <div class="stat-label">{stat.label}</div>
        </div>
      ))}
    </div>
  </section>

  <section class="section split tint">
    <div class="wrap split-grid">
      <div class="rv photo-frame accent">
        <Image src={consultPhoto} alt="A client consultation in progress at the Tax for Taxi Drivers office" width={900} height={1150} />
      </div>
      <div class="rv">
        <span class="eyebrow">Our approach</span>
        <h2>Face to face, not just a form.</h2>
        <p>
          Every client gets a proper conversation, not a portal login. We come to know your circumstances, your
          family, and what you're entitled to, so nothing gets missed on your return or your benefit claims.
        </p>
        <p>
          That's why we're proud to be the first accountancy practice in Northern Ireland to help clients claim
          Universal Credit alongside their Self Assessment.
        </p>
      </div>
    </div>
  </section>

  <section class="section split reverse">
    <div class="wrap split-grid">
      <div class="rv order-2 photo-frame">
        <Image src={teamPhoto} alt="Members of the Tax for Taxi Drivers team in the Belfast office" width={900} height={1150} />
      </div>
      <div class="rv order-1">
        <span class="eyebrow">The team</span>
        <h2>People, not a portal.</h2>
        <p>
          You'll always know who you're talking to, and they'll already know your situation. No call centres, no
          starting your story over with someone new every time you ring.
        </p>
        <a class="btn btn-y" href="tel:07799414972">Ring 07799 414972</a>
      </div>
    </div>
  </section>

  <section class="section visit tint">
    <div class="wrap">
      <div class="rv visit-photo">
        <Image src={shopfront} alt="The Tax for Taxi Drivers shopfront in Belfast" width={1180} height={560} />
      </div>
      <div class="rv visit-row">
        <div>
          <span class="eyebrow">Find us</span>
          <h2>Drop by, no appointment needed.</h2>
        </div>
        <a class="btn btn-ghost" href="/contact">Get in touch</a>
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .intro-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 54px;
    align-items: center;
  }

  .intro h1 {
    font-size: clamp(34px, 5vw, 54px);
    margin: 14px 0 18px;
    max-width: 16ch;
  }

  .intro .lead {
    font-size: 18px;
    color: var(--ink-2);
    max-width: 52ch;
    font-weight: 500;
    margin-top: 18px;
  }

  .photo-frame {
    position: relative;
  }

  .photo-frame :global(img) {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
  }

  .photo-frame.feature :global(img) {
    aspect-ratio: 3 / 4;
    object-position: center top;
    background: #1a1a1a;
  }

  .photo-frame.accent::before {
    content: '';
    position: absolute;
    right: -34px;
    top: -34px;
    width: 190px;
    height: 190px;
    border-radius: 50%;
    background: radial-gradient(circle, var(--yellow-soft), transparent 70%);
    z-index: 0;
  }

  .stats {
    background: var(--ink);
    padding: 56px 0;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  .stat-value {
    font-size: clamp(32px, 4.2vw, 48px);
    font-weight: 800;
    color: var(--yellow);
    letter-spacing: -0.01em;
    line-height: 1;
  }

  .stat-label {
    margin-top: 12px;
    color: #c3bdb1;
    font-weight: 600;
    font-size: 14.5px;
    max-width: 26ch;
  }

  .split.tint {
    background: var(--paper-2);
  }

  .split-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 48px;
    align-items: center;
  }

  .split h2 {
    font-size: clamp(26px, 3.4vw, 38px);
    margin-top: 12px;
  }

  .split p {
    color: var(--ink-2);
    font-weight: 500;
    margin-top: 14px;
    max-width: 46ch;
  }

  .split .btn {
    margin-top: 24px;
  }

  .split.reverse .split-grid {
    grid-template-columns: 1.1fr 0.9fr;
  }

  .visit.tint {
    background: var(--paper-2);
  }

  .visit-photo :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 21 / 9;
    object-fit: cover;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
  }

  .visit-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    flex-wrap: wrap;
    margin-top: 28px;
  }

  .visit-row h2 {
    font-size: clamp(24px, 3vw, 34px);
    margin-top: 10px;
  }

  @media (max-width: 860px) {
    .intro-grid,
    .split-grid,
    .split.reverse .split-grid {
      grid-template-columns: 1fr;
    }

    .order-1,
    .order-2 {
      order: initial;
    }

    .visit-photo :global(img) {
      aspect-ratio: 4 / 3;
    }
  }

  @media (max-width: 720px) {
    .stats-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>
