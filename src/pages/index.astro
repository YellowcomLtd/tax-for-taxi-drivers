---
export const prerender = true;
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Promise from '../components/Promise.astro';
import ServiceCards from '../components/ServiceCards.astro';
import PricingTable from '../components/PricingTable.astro';
import ReviewsTeaser from '../components/ReviewsTeaser.astro';
import ReferBand from '../components/ReferBand.astro';
import UcBand from '../components/UcBand.astro';
import CtaBand from '../components/CtaBand.astro';
import { localBusinessSchema, websiteSchema } from '../lib/seo';

const reviews = await getCollection('reviews');
const reviewCount = reviews.length;
const ratingValue =
  reviewCount > 0
    ? Math.round(
        (reviews.reduce((sum, r) => sum + (r.data.rating ?? 5), 0) / reviewCount) * 10
      ) / 10
    : undefined;

const jsonLd = [
  localBusinessSchema(
    ratingValue && reviewCount
      ? { aggregateRating: { ratingValue, reviewCount } }
      : undefined
  ),
  websiteSchema(),
];
---

<BaseLayout
  title="Tax for Taxi Drivers"
  description="Self Assessment, Making Tax Digital and HMRC help for taxi drivers in Belfast and Northern Ireland. Fixed monthly fees, face-to-face support, and 10+ years’ experience."
  jsonLd={jsonLd}
>
  <Hero />

  <section class="section" id="services">
    <div class="wrap">
      <div class="head-row">
        <div class="rv"><span class="eyebrow">What we do</span><h2 style="margin-top: 12px">More than just tax returns.</h2></div>
        <p class="rv">Everything a self-employed driver needs, handled by people who've done it for a decade. <a class="inline-link" href="/services">All services &amp; fees</a></p>
      </div>
      <ServiceCards />
    </div>
  </section>

  <Promise />

  <section class="section fees" id="fees">
    <div class="wrap">
      <div class="head-row">
        <div class="rv"><span class="eyebrow">Simple, fixed fees</span><h2 style="margin-top: 12px">Clear pricing. Paid monthly.</h2></div>
        <p class="rv">No hourly surprises. Pick the plan that fits where you are, and pay by direct debit.</p>
      </div>
      <PricingTable />
    </div>
  </section>

  <ReviewsTeaser />
  <ReferBand />
  <UcBand />
  <CtaBand />
</BaseLayout>

<style>
  .fees {
    background: var(--paper-2);
  }

  .inline-link {
    font-weight: 800;
    border-bottom: 1.5px solid var(--yellow-deep);
    white-space: nowrap;
  }
</style>
