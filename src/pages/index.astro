---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Promise from '../components/Promise.astro';
import ServiceCards from '../components/ServiceCards.astro';
import PricingTable from '../components/PricingTable.astro';
import ReviewsTeaser from '../components/ReviewsTeaser.astro';
import ReferBand from '../components/ReferBand.astro';
import UcBand from '../components/UcBand.astro';
import CtaBand from '../components/CtaBand.astro';
---

<BaseLayout
  title="Tax for Taxi Drivers"
  description="Self Assessment, benefit claims and HMRC support for self-employed taxi drivers in Belfast. Fixed monthly fees, paid by direct debit."
>
  <Hero />

  <section class="section" id="services">
    <div class="wrap">
      <div class="head-row">
        <div class="rv"><span class="eyebrow">What we do</span><h2 style="margin-top: 12px">More than just tax returns.</h2></div>
        <p class="rv">Everything a self-employed driver needs, handled by people who've done it for a decade.</p>
      </div>
      <ServiceCards />
    </div>
  </section>

  <Promise />

  <section class="section fees" id="fees">
    <div class="wrap">
      <div class="head-row">
        <div class="rv"><span class="eyebrow">Simple, fixed fees</span><h2 style="margin-top: 12px">Clear pricing. Paid monthly.</h2></div>
        <p class="rv">No hourly surprises. Pick the plan that fits where you are, and pay by direct debit.</p>
      </div>
      <PricingTable />
    </div>
  </section>

  <ReviewsTeaser />
  <ReferBand />
  <UcBand />
  <CtaBand />
</BaseLayout>

<style>
  .fees {
    background: var(--paper-2);
  }
</style>
