---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';

export async function getStaticPaths() {
  const posts = await getCollection('insights');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const dateFormat = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="section post">
    <div class="wrap narrow">
      <a class="back" href="/insights">&larr; All insights</a>
      {post.data.placeholder && <span class="badge">Coming soon</span>}
      <time datetime={post.data.pubDate.toISOString()}>{dateFormat.format(post.data.pubDate)}</time>
      <h1>{post.data.title}</h1>
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>

  <CtaBand />
</BaseLayout>

<style>
  .narrow {
    max-width: 720px;
  }

  .back {
    display: inline-block;
    font-weight: 700;
    font-size: 14px;
    color: var(--ink-2);
    margin-bottom: 18px;
  }

  .badge {
    display: inline-block;
    background: var(--yellow-soft);
    border: 1px solid #f3e4a8;
    color: #6b4e00;
    font-weight: 800;
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 999px;
    margin-bottom: 10px;
  }

  time {
    display: block;
    font-weight: 700;
    font-size: 12.5px;
    color: var(--ink-3);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-top: 4px;
  }

  h1 {
    font-size: clamp(30px, 4.4vw, 44px);
    margin: 10px 0 30px;
  }

  .prose {
    color: var(--ink-2);
    font-size: 17px;
    font-weight: 500;
    line-height: 1.75;
  }

  .prose :global(p) {
    margin-bottom: 18px;
  }

  .prose :global(h2) {
    color: var(--ink);
    font-size: 26px;
    margin: 40px 0 16px;
  }

  .prose :global(h3) {
    color: var(--ink);
    font-size: 20px;
    margin: 30px 0 12px;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 18px 22px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .prose :global(li) {
    padding-left: 4px;
  }

  .prose :global(strong) {
    color: var(--ink);
    font-weight: 800;
  }

  .prose :global(a) {
    color: var(--ink);
    font-weight: 700;
    border-bottom: 1.5px solid var(--yellow-deep);
  }

  .prose :global(blockquote) {
    border-left: 3px solid var(--yellow);
    padding-left: 18px;
    margin: 24px 0;
    color: var(--ink);
    font-weight: 600;
  }
</style>
