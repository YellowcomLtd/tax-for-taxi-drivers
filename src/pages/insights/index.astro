---
export const prerender = true;
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import InsightCover from '../../components/InsightCover.astro';
import InsightSidebar from '../../components/InsightSidebar.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getInsightCover } from '../../lib/insightCovers';

const posts = (await getCollection('insights', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const [featured, ...rest] = posts;
const dateFormat = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const shortDate = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

const site = Astro.site?.href ?? 'https://www.taxfortaxidrivers.co.uk';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Insights',
  description:
    'Tax tips, deadline reminders and Making Tax Digital updates for self-employed taxi drivers in Belfast.',
  url: new URL('/insights', site).href,
  publisher: {
    '@type': 'Organization',
    name: 'Tax for Taxi Drivers',
    url: site,
  },
};
---

<BaseLayout
  title="Tax insights for taxi drivers"
  description="Tax tips, Self Assessment deadlines and Making Tax Digital updates for self-employed taxi drivers in Belfast and Northern Ireland."
  jsonLd={jsonLd}
>
  <section class="section intro">
    <div class="wrap intro-grid">
      <div>
        <span class="eyebrow rv">Insights</span>
        <h1 class="rv">Tax tips &amp; deadline reminders.</h1>
        <p class="rv lead">
          Straightforward guidance for self-employed drivers - deadlines, allowable expenses, and what's changing with HMRC.
        </p>
      </div>
      <p class="rv note">
        Cover images on this page are temporary placeholders until final photography is ready.
      </p>
    </div>
  </section>

  <section class="section listing">
    <div class="wrap layout">
      <div class="main">
        {featured && (
          <a class="rv featured" href={`/insights/${featured.id}`}>
            <InsightCover src={getInsightCover(featured.id, featured.data.cover)} featured />
            <div class="featured-copy">
              <div class="meta">
                <span class="tag">Latest</span>
                <time datetime={featured.data.pubDate.toISOString()}>
                  {dateFormat.format(featured.data.pubDate)}
                </time>
              </div>
              <h2>{featured.data.title}</h2>
              <p>{featured.data.description}</p>
              <span class="read-more">Read article &rarr;</span>
            </div>
          </a>
        )}

        <div class="posts">
          {rest.map((post) => (
            <a class="rv post-card" href={`/insights/${post.id}`}>
              <InsightCover src={getInsightCover(post.id, post.data.cover)} />
              <div class="post-copy">
                {post.data.placeholder && <span class="badge">Coming soon</span>}
                <time datetime={post.data.pubDate.toISOString()}>{shortDate.format(post.data.pubDate)}</time>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
                <span class="read-more">Read more &rarr;</span>
              </div>
            </a>
          ))}
        </div>
      </div>

      <InsightSidebar
        relatedServiceIds={[
          'self-assessment',
          'making-tax-digital',
          'income-expenditure-records',
          'hmrc-tax-check',
        ]}
      />
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .intro {
    padding-bottom: 28px;
  }

  .intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.7fr);
    gap: 32px;
    align-items: end;
  }

  .intro h1 {
    font-size: clamp(34px, 5vw, 54px);
    margin: 14px 0 12px;
    max-width: 18ch;
  }

  .intro .lead {
    font-size: 18px;
    color: var(--ink-2);
    max-width: 48ch;
    font-weight: 500;
  }

  .note {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--ink-3);
    background: var(--paper-2);
    border: 1px dashed #d2cbb8;
    border-radius: 14px;
    padding: 16px 18px;
    line-height: 1.45;
  }

  .listing {
    padding-top: 12px;
    padding-bottom: 72px;
    background: var(--paper);
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 40px;
    align-items: start;
  }

  .featured {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: 28px;
    align-items: center;
    margin-bottom: 36px;
    padding-bottom: 36px;
    border-bottom: 1px solid var(--line);
  }

  .featured-copy .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }

  .tag {
    background: var(--ink);
    color: var(--yellow);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 999px;
  }

  .featured time,
  .post-card time {
    font-weight: 800;
    font-size: 12px;
    color: var(--ink-3);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .featured h2 {
    font-size: clamp(24px, 3vw, 32px);
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin-bottom: 10px;
  }

  .featured p,
  .post-card p {
    color: var(--ink-2);
    font-size: 15px;
    font-weight: 500;
    line-height: 1.5;
  }

  .posts {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .post-card {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 20px;
    align-items: center;
    padding: 12px;
    margin: 0 -12px;
    border-radius: 18px;
    transition: background 0.15s ease;
  }

  .post-card:hover {
    background: var(--paper-2);
  }

  .post-copy {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
    position: relative;
  }

  .post-card h3 {
    font-size: 20px;
    letter-spacing: -0.015em;
    line-height: 1.2;
  }

  .badge {
    position: absolute;
    top: 0;
    right: 0;
    background: var(--yellow-soft);
    border: 1px solid #f3e4a8;
    color: #6b4e00;
    font-weight: 800;
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 999px;
  }

  .read-more {
    margin-top: 4px;
    font-weight: 800;
    font-size: 14px;
    color: var(--ink);
  }

  .featured:hover .read-more,
  .post-card:hover .read-more {
    border-bottom: 1.5px solid var(--yellow-deep);
    align-self: start;
  }

  @media (max-width: 980px) {
    .intro-grid,
    .layout,
    .featured,
    .post-card {
      grid-template-columns: 1fr;
    }

    .featured {
      gap: 18px;
    }

    .post-card {
      gap: 14px;
      margin: 0;
      padding: 0;
    }
  }
</style>
