---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';

const posts = (await getCollection('insights', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const dateFormat = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout
  title="Insights"
  description="Tax tips, deadline reminders and Making Tax Digital updates for self-employed taxi drivers in Belfast."
>
  <section class="section intro">
    <div class="wrap">
      <span class="eyebrow rv">Insights</span>
      <h1 class="rv">Tax tips &amp; deadline reminders.</h1>
      <p class="rv lead">Straightforward guidance for self-employed drivers &mdash; deadlines, allowable expenses, and what's changing with HMRC.</p>
    </div>
  </section>

  <section class="section posts-section">
    <div class="wrap">
      <div class="posts">
        {posts.map((post) => (
          <a class="rv post-card" href={`/insights/${post.id}`}>
            {post.data.placeholder && <span class="badge">Coming soon</span>}
            <time datetime={post.data.pubDate.toISOString()}>{dateFormat.format(post.data.pubDate)}</time>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
            <span class="read-more">Read more &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .intro h1 {
    font-size: clamp(34px, 5vw, 54px);
    margin: 14px 0 12px;
    max-width: 20ch;
  }

  .intro .lead {
    font-size: 18px;
    color: var(--ink-2);
    max-width: 55ch;
    font-weight: 500;
  }

  .posts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .post-card {
    position: relative;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 26px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .post-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
  }

  .badge {
    position: absolute;
    top: 18px;
    right: 18px;
    background: var(--yellow-soft);
    border: 1px solid #f3e4a8;
    color: #6b4e00;
    font-weight: 800;
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 999px;
  }

  .post-card time {
    font-weight: 700;
    font-size: 12.5px;
    color: var(--ink-3);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .post-card h2 {
    font-size: 20px;
    margin-top: 4px;
  }

  .post-card p {
    color: var(--ink-2);
    font-size: 15px;
    font-weight: 500;
  }

  .read-more {
    margin-top: auto;
    padding-top: 10px;
    font-weight: 800;
    font-size: 14px;
    color: var(--ink);
  }

  @media (max-width: 860px) {
    .posts {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .posts {
      grid-template-columns: 1fr;
    }
  }
</style>
