---
export const prerender = true;
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';

const allReviews = await getCollection('reviews');

function tierFor(quote: string, featured: boolean) {
  if (featured) return 'xl';
  if (quote.length > 130) return 'lg';
  if (quote.length > 70) return 'md';
  return 'sm';
}

const reviews = allReviews.map((review, index) => ({
  ...review.data,
  tier: tierFor(review.data.quote, review.data.featured),
  delay: (index % 8) * 70,
}));

const reviewCount = allReviews.length;
const ratingValue =
  reviewCount > 0
    ? Math.round(
        (allReviews.reduce((sum, r) => sum + (r.data.rating ?? 5), 0) / reviewCount) * 10
      ) / 10
    : 5;

const site = Astro.site?.href ?? 'https://www.taxfortaxidrivers.co.uk';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Client reviews',
  description:
    'Real reviews from Tax for Taxi Drivers clients across Belfast and Northern Ireland.',
  url: new URL('/reviews', site).href,
  about: {
    '@type': 'AccountingService',
    name: 'Tax for Taxi Drivers',
    url: site,
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue,
      reviewCount,
      bestRating: 5,
      worstRating: 1,
    },
  },
};
---

<BaseLayout
  title="Client reviews — Belfast taxi drivers"
  description="Real reviews from Tax for Taxi Drivers clients across Belfast and Northern Ireland. Honest feedback from drivers we help with Self Assessment and HMRC."
  jsonLd={jsonLd}
>
  <section class="section intro">
    <div class="wrap">
      <span class="eyebrow rv">Genuine client reviews</span>
      <h1 class="rv">Drivers who'd send a mate our way.</h1>
      <p class="rv lead">Every quote here is a real comment from a real client &mdash; some from our website, some collected in person at the office. Ask to see more any time.</p>
    </div>
  </section>

  <section class="section cloud-section">
    <div class="wrap">
      <div class="cloud">
        {reviews.map((review) => (
          <div class={`rv word tier-${review.tier}`} style={`--delay: ${review.delay}ms`}>
            <span class="stars" set:html={'&#9733;'.repeat(review.rating)} />
            <p>&ldquo;{review.quote}&rdquo;</p>
            <span class="who">&mdash; {review.attribution}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .intro h1 {
    font-size: clamp(34px, 5vw, 54px);
    margin: 14px 0 12px;
    max-width: 20ch;
  }

  .intro .lead {
    font-size: 18px;
    color: var(--ink-2);
    max-width: 60ch;
    font-weight: 500;
  }

  .cloud-section {
    padding-top: 20px;
  }

  .cloud {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: center;
    gap: 30px 44px;
  }

  .word {
    transition-delay: var(--delay);
    max-width: 46ch;
    text-align: left;
  }

  .word .stars {
    display: block;
    color: var(--yellow-deep);
    letter-spacing: 2px;
    margin-bottom: 8px;
  }

  .word p {
    font-weight: 700;
    line-height: 1.3;
  }

  .word .who {
    display: block;
    margin-top: 10px;
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  .tier-sm {
    max-width: 30ch;
  }

  .tier-sm p {
    font-size: 16px;
    color: var(--ink-2);
    opacity: 0.92;
  }

  .tier-sm .stars {
    font-size: 12px;
  }

  .tier-sm .who {
    font-size: 12px;
    color: var(--ink-3);
  }

  .tier-md p {
    font-size: 20px;
    color: var(--ink-2);
  }

  .tier-md .stars {
    font-size: 13px;
  }

  .tier-md .who {
    font-size: 12.5px;
    color: var(--ink-3);
  }

  .tier-lg {
    max-width: 40ch;
  }

  .tier-lg p {
    font-size: 26px;
    color: var(--ink);
  }

  .tier-lg .stars {
    font-size: 14px;
  }

  .tier-lg .who {
    font-size: 13.5px;
    color: var(--ink-2);
  }

  .tier-xl {
    max-width: 48ch;
  }

  .tier-xl p {
    font-size: 32px;
    color: var(--ink);
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .tier-xl .stars {
    font-size: 15px;
  }

  .tier-xl .who {
    font-size: 14px;
    color: var(--ink-2);
  }

  @media (max-width: 640px) {
    .cloud {
      gap: 26px;
    }

    .word,
    .tier-sm,
    .tier-md,
    .tier-lg,
    .tier-xl {
      max-width: 100%;
    }

    .tier-xl p {
      font-size: 24px;
    }

    .tier-lg p {
      font-size: 20px;
    }

    .tier-md p {
      font-size: 17px;
    }

    .tier-sm p {
      font-size: 15px;
    }
  }
</style>
