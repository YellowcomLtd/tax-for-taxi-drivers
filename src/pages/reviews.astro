---
export const prerender = true;
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';

const allReviews = await getCollection('reviews');

function tierFor(quote: string, featured: boolean) {
  if (featured) return 'xl';
  if (quote.length > 130) return 'lg';
  if (quote.length > 70) return 'md';
  return 'sm';
}

const reviews = allReviews.map((review, index) => ({
  ...review.data,
  tier: tierFor(review.data.quote, review.data.featured),
  delay: (index % 8) * 70,
}));

const site = Astro.site?.href ?? 'https://www.taxfortaxidrivers.co.uk';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Client reviews',
  description:
    'Real reviews from Tax for Taxi Drivers clients across Belfast and Northern Ireland.',
  url: new URL('/reviews', site).href,
  about: { '@id': `${site.replace(/\/$/, '')}/#business` },
};
---

<BaseLayout
  title="Client reviews — Belfast taxi drivers"
  description="Real reviews from Tax for Taxi Drivers clients across Belfast and Northern Ireland. Honest feedback from drivers we help with Self Assessment and HMRC."
  jsonLd={jsonLd}
>
  <section class="section intro">
    <div class="wrap">
      <span class="eyebrow rv">Genuine client reviews</span>
      <h1 class="rv">Drivers who'd send a mate our way.</h1>
      <p class="rv lead">Every quote here is a real comment from a real client &mdash; some from our website, some collected in person at the office. Ask to see more any time.</p>
    </div>
  </section>

  <section class="section cloud-section">
    <div class="wrap">
      <div class="cloud">
        {reviews.map((review) => (
          <div class={`rv word tier-${review.tier}`} style={`--delay: ${review.delay}ms`}>
            {typeof review.rating === 'number' && (
              <span class="stars" set:html={'&#9733;'.repeat(review.rating)} />
            )}
            <p>&ldquo;{review.quote}&rdquo;</p>
            <span class="who">&mdash; {review.attribution}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .intro {
    padding-bottom: 24px;
  }

  .intro h1 {
    font-size: clamp(34px, 5vw, 54px);
    margin: 14px 0 14px;
    max-width: 20ch;
  }

  .lead {
    font-size: 18px;
    color: var(--ink-2);
    max-width: 60ch;
    font-weight: 500;
  }

  .cloud-section {
    padding-top: 20px;
  }

  .cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 18px;
    align-items: center;
    justify-content: center;
    max-width: 980px;
    margin: 0 auto;
  }

  .word {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 16px 18px;
    max-width: 46ch;
  }

  .word .stars {
    display: block;
    color: var(--yellow-deep);
    letter-spacing: 2px;
    font-size: 13px;
    margin-bottom: 8px;
  }

  .word p {
    font-weight: 600;
    color: var(--ink);
    line-height: 1.45;
  }

  .word .who {
    display: block;
    margin-top: 10px;
    font-size: 13px;
    font-weight: 800;
    color: var(--ink-2);
  }

  .tier-xl {
    font-size: 20px;
    max-width: 30ch;
    opacity: 1;
  }

  .tier-lg {
    font-size: 17px;
    max-width: 40ch;
    opacity: 0.95;
  }

  .tier-md {
    font-size: 15.5px;
    max-width: 36ch;
    opacity: 0.9;
  }

  .tier-sm {
    font-size: 14.5px;
    max-width: 28ch;
    opacity: 0.85;
  }

  @media (max-width: 640px) {
    .cloud {
      gap: 12px;
    }

    .word {
      max-width: 100%;
    }
  }
</style>
