---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceRelated from '../../components/ServiceRelated.astro';
import ServiceFaq from '../../components/ServiceFaq.astro';
import ReferBand from '../../components/ReferBand.astro';
import CtaBand from '../../components/CtaBand.astro';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((service) => ({
    params: { slug: service.id },
    props: { service },
  }));
}

const { service } = Astro.props;
const { Content } = await render(service);
const site = Astro.site?.href ?? 'https://www.taxfortaxidrivers.co.uk';
const pageUrl = new URL(`/services/${service.id}`, site).href;

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', site).href },
    { '@type': 'ListItem', position: 2, name: 'Services', item: new URL('/services', site).href },
    { '@type': 'ListItem', position: 3, name: service.data.shortTitle, item: pageUrl },
  ],
};

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.data.shortTitle,
  description: service.data.description,
  url: pageUrl,
  areaServed: [
    { '@type': 'City', name: 'Belfast' },
    { '@type': 'AdministrativeArea', name: 'Northern Ireland' },
    { '@type': 'Country', name: 'United Kingdom' },
  ],
  provider: {
    '@type': 'AccountingService',
    name: 'Tax for Taxi Drivers',
    url: site,
    telephone: '+447799414972',
    email: 'info@taxfortaxidrivers.co.uk',
    areaServed: 'Northern Ireland',
  },
  audience: {
    '@type': 'Audience',
    audienceType: 'Self-employed taxi and private-hire drivers',
  },
};

const faqLd =
  service.data.faqs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: service.data.faqs.map((faq) => ({
          '@type': 'Question',
          name: faq.question,
          acceptedAnswer: { '@type': 'Answer', text: faq.answer },
        })),
      }
    : null;

const jsonLd = [breadcrumbLd, serviceLd, ...(faqLd ? [faqLd] : [])];
---

<BaseLayout title={service.data.title} description={service.data.description} jsonLd={jsonLd}>
  <article>
    <header class="section hero">
      <div class="wrap narrow">
        <nav class="crumbs rv" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <a href="/services">Services</a>
          <span aria-hidden="true">/</span>
          <span>{service.data.shortTitle}</span>
        </nav>
        <div class="ico rv" aria-hidden="true">{service.data.icon}</div>
        <h1 class="rv">{service.data.title}</h1>
        <p class="rv lead">{service.data.heroLead}</p>
        {service.data.planNote && <p class="rv plan-note">{service.data.planNote}</p>}
        <div class="rv actions">
          <a class="btn btn-y" href="/contact">Contact us</a>
          <a class="btn btn-ghost" href="tel:07799414972">Ring 07799 414972</a>
        </div>
      </div>
    </header>

    <section class="section body">
      <div class="wrap narrow">
        <div class="prose">
          <Content />
        </div>
      </div>
    </section>

    {service.data.faqs.length > 0 && <ServiceFaq faqs={service.data.faqs} />}

    <ServiceRelated
      currentId={service.id}
      relatedServiceIds={service.data.relatedServices}
      relatedInsightIds={service.data.relatedInsights}
    />
  </article>

  <ReferBand />
  <CtaBand />
</BaseLayout>

<style>
  .hero {
    padding-bottom: 48px;
  }

  .narrow {
    max-width: 760px;
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 700;
    color: var(--ink-3);
    margin-bottom: 22px;
  }

  .crumbs a {
    color: var(--ink-2);
  }

  .crumbs a:hover {
    color: var(--ink);
  }

  .ico {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: var(--yellow-soft);
    border: 1px solid #f3e4a8;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 26px;
    margin-bottom: 18px;
  }

  h1 {
    font-size: clamp(30px, 4.6vw, 46px);
    max-width: 22ch;
  }

  .lead {
    font-size: 18px;
    color: var(--ink-2);
    font-weight: 500;
    margin-top: 14px;
    max-width: 54ch;
  }

  .plan-note {
    margin-top: 16px;
    display: inline-block;
    background: var(--yellow-soft);
    border: 1px solid #f3e4a8;
    color: #6b4e00;
    font-weight: 700;
    font-size: 13.5px;
    padding: 8px 14px;
    border-radius: 999px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 26px;
  }

  .body {
    padding-top: 0;
  }

  .prose {
    color: var(--ink-2);
    font-size: 17px;
    font-weight: 500;
    line-height: 1.75;
  }

  .prose :global(p) {
    margin-bottom: 18px;
  }

  .prose :global(h2) {
    color: var(--ink);
    font-size: 26px;
    margin: 40px 0 16px;
  }

  .prose :global(h3) {
    color: var(--ink);
    font-size: 20px;
    margin: 30px 0 12px;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 18px 22px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .prose :global(li) {
    padding-left: 4px;
  }

  .prose :global(strong) {
    color: var(--ink);
    font-weight: 800;
  }

  .prose :global(a) {
    color: var(--ink);
    font-weight: 700;
    border-bottom: 1.5px solid var(--yellow-deep);
  }
</style>
