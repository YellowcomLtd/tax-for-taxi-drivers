---
export const prerender = true;
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceSidebar from '../../components/ServiceSidebar.astro';
import ServiceFaq from '../../components/ServiceFaq.astro';
import ReferBand from '../../components/ReferBand.astro';
import CtaBand from '../../components/CtaBand.astro';

import peopleConsult from '../../assets/images/heroes/people-consult.jpg';
import peopleMichael from '../../assets/images/heroes/people-michael-notes.jpg';
import peopleCouple from '../../assets/images/heroes/people-couple.jpg';
import peopleDeskMeeting from '../../assets/images/heroes/people-desk-meeting.jpg';
import peopleTeamWomen from '../../assets/images/heroes/people-team-women.jpg';
import peopleTeamThree from '../../assets/images/heroes/people-team-three.jpg';
import deskPaperwork from '../../assets/images/heroes/desk-paperwork.jpg';
import deskForms from '../../assets/images/heroes/desk-forms.jpg';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((service) => ({
    params: { slug: service.id },
    props: { service },
  }));
}

/** Prefer face-forward people crops; use desk/paperwork where that reads better for the topic. */
const heroMap: Record<string, { image: ImageMetadata; alt: string; position?: string }> = {
  'self-assessment': {
    image: peopleConsult,
    alt: 'A client consultation at the Tax for Taxi Drivers office',
    position: 'center center',
  },
  'benefit-claims': {
    image: peopleCouple,
    alt: 'Michael with a client after reviewing their figures',
    position: 'center 40%',
  },
  'hmrc-penalty-appeals': {
    image: peopleMichael,
    alt: 'Michael reviewing tax figures in the office',
    position: 'center 35%',
  },
  'income-expenditure-records': {
    image: deskForms,
    alt: 'Office desk with forms, phone and laptop',
    position: 'center center',
  },
  'pensions-national-insurance': {
    image: peopleTeamWomen,
    alt: 'Members of the Tax for Taxi Drivers team',
    position: 'center 30%',
  },
  'hmrc-investigations': {
    image: peopleDeskMeeting,
    alt: 'Face-to-face meeting over tax paperwork',
    position: 'center 35%',
  },
  'making-tax-digital': {
    image: deskPaperwork,
    alt: 'Laptop, keyboard and tax paperwork on a desk',
    position: 'right center',
  },
  'hmrc-tax-check': {
    image: peopleTeamThree,
    alt: 'The Tax for Taxi Drivers team in the Belfast office',
    position: 'center 40%',
  },
  'loss-of-earnings': {
    image: deskForms,
    alt: 'Close-up of an office desk during a consultation',
    position: 'center center',
  },
};

const { service } = Astro.props;
const { Content } = await render(service);
const hero = heroMap[service.id] ?? {
  image: peopleConsult,
  alt: 'Tax for Taxi Drivers office',
  position: 'center center',
};
const site = Astro.site?.href ?? 'https://www.taxfortaxidrivers.co.uk';
const pageUrl = new URL(`/services/${service.id}`, site).href;

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', site).href },
    { '@type': 'ListItem', position: 2, name: 'Services', item: new URL('/services', site).href },
    { '@type': 'ListItem', position: 3, name: service.data.shortTitle, item: pageUrl },
  ],
};

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.data.shortTitle,
  description: service.data.description,
  url: pageUrl,
  areaServed: [
    { '@type': 'City', name: 'Belfast' },
    { '@type': 'AdministrativeArea', name: 'Northern Ireland' },
    { '@type': 'Country', name: 'United Kingdom' },
  ],
  provider: {
    '@id': `${site.replace(/\/$/, '')}/#business`,
  },
  audience: {
    '@type': 'Audience',
    audienceType: 'Self-employed taxi and private-hire drivers',
  },
};

const jsonLd = [breadcrumbLd, serviceLd];
---

<BaseLayout title={service.data.title} description={service.data.description} jsonLd={jsonLd}>
  <article>
    <header class="service-hero">
      <div class="hero-media">
        <Image
          src={hero.image}
          alt={hero.alt}
          width={1800}
          height={900}
          class="hero-img"
          style={`object-position: ${hero.position ?? 'center center'};`}
        />
        <div class="hero-shade" aria-hidden="true"></div>
      </div>
      <div class="wrap hero-copy">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <a href="/services">Services</a>
          <span aria-hidden="true">/</span>
          <span>{service.data.shortTitle}</span>
        </nav>
        <p class="hero-kicker"><span aria-hidden="true">{service.data.icon}</span> {service.data.shortTitle}</p>
        <h1>{service.data.title}</h1>
        <p class="lead">{service.data.heroLead}</p>
        {service.data.planNote && <p class="plan-note">{service.data.planNote}</p>}
        <div class="actions">
          <a class="btn btn-y" href="tel:07799414972">Ring Michael</a>
          <a class="btn btn-ghost-light" href="/contact">Contact us</a>
        </div>
      </div>
    </header>

    <section class="section body">
      <div class="wrap layout">
        <div class="main">
          <div class="prose">
            <Content />
          </div>

          {service.data.faqs.length > 0 && (
            <div class="faq-block">
              <ServiceFaq faqs={service.data.faqs} embedded />
            </div>
          )}
        </div>

        <ServiceSidebar
          currentId={service.id}
          relatedServiceIds={service.data.relatedServices}
          relatedInsightIds={service.data.relatedInsights}
        />
      </div>
    </section>
  </article>

  <ReferBand />
  <CtaBand />
</BaseLayout>

<style>
  .service-hero {
    position: relative;
    min-height: clamp(340px, 48vw, 460px);
    display: flex;
    align-items: flex-end;
    color: #fff;
    overflow: hidden;
  }

  .hero-media {
    position: absolute;
    inset: 0;
  }

  .hero-media :global(img),
  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(20, 19, 16, 0.88) 0%, rgba(20, 19, 16, 0.62) 48%, rgba(20, 19, 16, 0.35) 100%),
      linear-gradient(0deg, rgba(20, 19, 16, 0.55) 0%, transparent 55%);
  }

  .hero-copy {
    position: relative;
    z-index: 1;
    padding: 56px 0 48px;
    max-width: min(1180px, 92vw);
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 700;
    color: #c3bdb1;
    margin-bottom: 18px;
  }

  .crumbs a {
    color: #e8e2d4;
  }

  .crumbs a:hover {
    color: var(--yellow);
  }

  .hero-kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--yellow);
    margin-bottom: 12px;
  }

  h1 {
    font-size: clamp(30px, 4.8vw, 48px);
    max-width: 18ch;
    color: #fff;
  }

  .lead {
    font-size: 17.5px;
    color: #d8d3c6;
    font-weight: 500;
    margin-top: 14px;
    max-width: 48ch;
    line-height: 1.55;
  }

  .plan-note {
    margin-top: 16px;
    display: inline-block;
    background: rgba(255, 196, 0, 0.18);
    border: 1px solid rgba(255, 196, 0, 0.35);
    color: var(--yellow);
    font-weight: 700;
    font-size: 13.5px;
    padding: 8px 14px;
    border-radius: 999px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 26px;
  }

  .btn-ghost-light {
    background: transparent;
    color: #fff;
    border: 1.5px solid rgba(255, 255, 255, 0.45);
  }

  .btn-ghost-light:hover {
    background: #fff;
    color: var(--ink);
    border-color: #fff;
  }

  .body {
    padding-top: 56px;
    padding-bottom: 72px;
    background: var(--paper);
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 48px;
    align-items: start;
  }

  .prose {
    color: var(--ink-2);
    font-size: 17px;
    font-weight: 500;
    line-height: 1.75;
  }

  .prose :global(p) {
    margin-bottom: 18px;
  }

  .prose :global(h2) {
    color: var(--ink);
    font-size: 26px;
    margin: 40px 0 16px;
  }

  .prose :global(h3) {
    color: var(--ink);
    font-size: 20px;
    margin: 30px 0 12px;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 18px 22px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .prose :global(li) {
    padding-left: 4px;
  }

  .prose :global(strong) {
    color: var(--ink);
    font-weight: 800;
  }

  .prose :global(a) {
    color: var(--ink);
    font-weight: 700;
    border-bottom: 1.5px solid var(--yellow-deep);
  }

  .faq-block {
    margin-top: 48px;
  }

  @media (max-width: 980px) {
    .layout {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .service-hero {
      min-height: 380px;
    }

    .hero-copy {
      padding: 44px 0 36px;
    }
  }
</style>
