---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceSidebar from '../../components/ServiceSidebar.astro';
import ServiceFaq from '../../components/ServiceFaq.astro';
import ReferBand from '../../components/ReferBand.astro';
import CtaBand from '../../components/CtaBand.astro';

import consult1 from '../../assets/images/office-consult-1.jpg';
import consult2 from '../../assets/images/office-consult-2.jpg';
import consult3 from '../../assets/images/office-consult-3.jpg';
import consult4 from '../../assets/images/office-consult-4.jpg';
import team from '../../assets/images/office-team-1.jpg';
import shopfront from '../../assets/images/shopfront.jpg';
import heroTeam from '../../assets/images/hero-team.jpg';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((service) => ({
    params: { slug: service.id },
    props: { service },
  }));
}

const heroMap: Record<string, ImageMetadata> = {
  'self-assessment': consult1,
  'benefit-claims': consult3,
  'hmrc-penalty-appeals': consult2,
  'income-expenditure-records': consult4,
  'pensions-national-insurance': team,
  'hmrc-investigations': shopfront,
  'making-tax-digital': consult1,
  'hmrc-tax-check': consult2,
  'loss-of-earnings': heroTeam,
};

const { service } = Astro.props;
const { Content } = await render(service);
const heroImage = heroMap[service.id] ?? consult3;
const site = Astro.site?.href ?? 'https://www.taxfortaxidrivers.co.uk';
const pageUrl = new URL(`/services/${service.id}`, site).href;

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', site).href },
    { '@type': 'ListItem', position: 2, name: 'Services', item: new URL('/services', site).href },
    { '@type': 'ListItem', position: 3, name: service.data.shortTitle, item: pageUrl },
  ],
};

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.data.shortTitle,
  description: service.data.description,
  url: pageUrl,
  areaServed: [
    { '@type': 'City', name: 'Belfast' },
    { '@type': 'AdministrativeArea', name: 'Northern Ireland' },
    { '@type': 'Country', name: 'United Kingdom' },
  ],
  provider: {
    '@type': 'AccountingService',
    name: 'Tax for Taxi Drivers',
    url: site,
    telephone: '+447799414972',
    email: 'info@taxfortaxidrivers.co.uk',
    areaServed: 'Northern Ireland',
  },
  audience: {
    '@type': 'Audience',
    audienceType: 'Self-employed taxi and private-hire drivers',
  },
};

const faqLd =
  service.data.faqs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: service.data.faqs.map((faq) => ({
          '@type': 'Question',
          name: faq.question,
          acceptedAnswer: { '@type': 'Answer', text: faq.answer },
        })),
      }
    : null;

const jsonLd = [breadcrumbLd, serviceLd, ...(faqLd ? [faqLd] : [])];
---

<BaseLayout title={service.data.title} description={service.data.description} jsonLd={jsonLd}>
  <article>
    <header class="service-hero">
      <div class="hero-media">
        <Image
          src={heroImage}
          alt=""
          width={1800}
          height={900}
          class="hero-img"
        />
        <div class="hero-shade" aria-hidden="true"></div>
      </div>
      <div class="wrap hero-copy">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <a href="/services">Services</a>
          <span aria-hidden="true">/</span>
          <span>{service.data.shortTitle}</span>
        </nav>
        <p class="hero-kicker"><span aria-hidden="true">{service.data.icon}</span> {service.data.shortTitle}</p>
        <h1>{service.data.title}</h1>
        <p class="lead">{service.data.heroLead}</p>
        {service.data.planNote && <p class="plan-note">{service.data.planNote}</p>}
        <div class="actions">
          <a class="btn btn-y" href="tel:07799414972">Ring Michael</a>
          <a class="btn btn-ghost-light" href="/contact">Contact us</a>
        </div>
      </div>
    </header>

    <section class="section body">
      <div class="wrap layout">
        <div class="main">
          <div class="prose">
            <Content />
          </div>

          {service.data.faqs.length > 0 && (
            <div class="faq-block">
              <ServiceFaq faqs={service.data.faqs} embedded />
            </div>
          )}
        </div>

        <ServiceSidebar
          currentId={service.id}
          relatedServiceIds={service.data.relatedServices}
          relatedInsightIds={service.data.relatedInsights}
        />
      </div>
    </section>
  </article>

  <ReferBand />
  <CtaBand />
</BaseLayout>

<style>
  .service-hero {
    position: relative;
    min-height: clamp(340px, 48vw, 460px);
    display: flex;
    align-items: flex-end;
    color: #fff;
    overflow: hidden;
  }

  .hero-media {
    position: absolute;
    inset: 0;
  }

  .hero-media :global(img),
  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }

  .hero-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(20, 19, 16, 0.88) 0%, rgba(20, 19, 16, 0.62) 48%, rgba(20, 19, 16, 0.35) 100%),
      linear-gradient(0deg, rgba(20, 19, 16, 0.55) 0%, transparent 55%);
  }

  .hero-copy {
    position: relative;
    z-index: 1;
    padding: 56px 0 48px;
    max-width: min(1180px, 92vw);
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 700;
    color: #c3bdb1;
    margin-bottom: 18px;
  }

  .crumbs a {
    color: #e8e2d4;
  }

  .crumbs a:hover {
    color: var(--yellow);
  }

  .hero-kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--yellow);
    margin-bottom: 12px;
  }

  h1 {
    font-size: clamp(30px, 4.8vw, 48px);
    max-width: 18ch;
    color: #fff;
  }

  .lead {
    font-size: 17.5px;
    color: #d8d3c6;
    font-weight: 500;
    margin-top: 14px;
    max-width: 48ch;
    line-height: 1.55;
  }

  .plan-note {
    margin-top: 16px;
    display: inline-block;
    background: rgba(255, 196, 0, 0.18);
    border: 1px solid rgba(255, 196, 0, 0.35);
    color: var(--yellow);
    font-weight: 700;
    font-size: 13.5px;
    padding: 8px 14px;
    border-radius: 999px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 26px;
  }

  .btn-ghost-light {
    background: transparent;
    color: #fff;
    border: 1.5px solid rgba(255, 255, 255, 0.45);
  }

  .btn-ghost-light:hover {
    background: #fff;
    color: var(--ink);
    border-color: #fff;
  }

  .body {
    padding-top: 56px;
    padding-bottom: 72px;
    background: var(--paper);
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 48px;
    align-items: start;
  }

  .prose {
    color: var(--ink-2);
    font-size: 17px;
    font-weight: 500;
    line-height: 1.75;
  }

  .prose :global(p) {
    margin-bottom: 18px;
  }

  .prose :global(h2) {
    color: var(--ink);
    font-size: 26px;
    margin: 40px 0 16px;
  }

  .prose :global(h3) {
    color: var(--ink);
    font-size: 20px;
    margin: 30px 0 12px;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 18px 22px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .prose :global(li) {
    padding-left: 4px;
  }

  .prose :global(strong) {
    color: var(--ink);
    font-weight: 800;
  }

  .prose :global(a) {
    color: var(--ink);
    font-weight: 700;
    border-bottom: 1.5px solid var(--yellow-deep);
  }

  .faq-block {
    margin-top: 48px;
  }

  @media (max-width: 980px) {
    .layout {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .service-hero {
      min-height: 380px;
    }

    .hero-copy {
      padding: 44px 0 36px;
    }
  }
</style>
