---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceCards from '../../components/ServiceCards.astro';
import PricingTable from '../../components/PricingTable.astro';
import ServiceDirectory from '../../components/ServiceDirectory.astro';
import ReferBand from '../../components/ReferBand.astro';
import CtaBand from '../../components/CtaBand.astro';

const site = Astro.site?.href ?? 'https://www.taxfortaxidrivers.co.uk';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Services & fees for taxi drivers',
  description:
    'Self Assessment, benefit claims, HMRC investigations and more for self-employed taxi drivers in Belfast and Northern Ireland.',
  url: new URL('/services', site).href,
  isPartOf: { '@type': 'WebSite', name: 'Tax for Taxi Drivers', url: site },
};
---

<BaseLayout
  title="Services & fees"
  description="Self Assessment, benefit claims, HMRC investigations and more for self-employed taxi drivers in Belfast and Northern Ireland. Fixed monthly fees."
  jsonLd={jsonLd}
>
  <section class="section">
    <div class="wrap">
      <span class="eyebrow rv">What we do</span>
      <h1 class="rv">Everything a self-employed driver needs.</h1>
      <p class="rv lead">
        From your first HMRC registration to a full benefit entitlement check - for taxi drivers in Belfast, across Northern Ireland, and further afield.
      </p>
      <ServiceCards />
    </div>
  </section>

  <section class="section directory">
    <div class="wrap">
      <div class="head-row">
        <div class="rv">
          <span class="eyebrow">All service pages</span>
          <h2 style="margin-top: 12px">Explore each service in detail.</h2>
        </div>
        <p class="rv">SEO-focused guides with cross-links, fees context, and how to get in touch.</p>
      </div>
      <ServiceDirectory />
    </div>
  </section>

  <section class="section fees">
    <div class="wrap">
      <div class="head-row">
        <div class="rv"><span class="eyebrow">Simple, fixed fees</span><h2 style="margin-top: 12px">Clear pricing. Paid monthly.</h2></div>
        <p class="rv">No hourly surprises. Pick the plan that fits where you are, and pay by direct debit.</p>
      </div>
      <PricingTable />
    </div>
  </section>

  <ReferBand />
  <CtaBand />
</BaseLayout>

<style>
  h1 {
    font-size: clamp(34px, 5vw, 54px);
    margin: 14px 0 12px;
    max-width: 22ch;
  }

  .lead {
    font-size: 18px;
    color: var(--ink-2);
    max-width: 55ch;
    font-weight: 500;
  }

  .directory {
    background: var(--paper-2);
    padding-bottom: 72px;
  }

  .fees {
    background: var(--paper);
  }
</style>
