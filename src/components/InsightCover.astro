---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { PLACEHOLDER_IMAGE_ALT } from '../lib/insightCovers';

interface Props {
  src: ImageMetadata;
  alt?: string;
  /** Larger featured treatment on article pages */
  featured?: boolean;
  class?: string;
}

const {
  src,
  alt = PLACEHOLDER_IMAGE_ALT,
  featured = false,
  class: className = '',
} = Astro.props;
---

<figure class:list={['insight-cover', featured && 'featured', className]}>
  <Image
    src={src}
    alt={alt}
    width={featured ? 1400 : 800}
    height={featured ? 788 : 450}
    class="cover-img"
  />
</figure>

<style>
  .insight-cover {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: 16px;
    background: var(--paper-2);
    border: 1px solid var(--line);
  }

  .insight-cover.featured {
    border-radius: 20px;
  }

  .cover-img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
</style>
