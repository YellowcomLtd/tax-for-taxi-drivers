---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo.png';

const year = 2026;
---

<footer class="foot">
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <a class="brand" href="/">
          <Image src={logo} alt="Tax for Taxi Drivers logo" width={44} height={44} />
          <span class="brand-text"><b>Tax for Taxi Drivers</b><span>Tax made easy</span></span>
        </a>
        <p>Self-employed accountancy specialists based in Belfast. Tax returns, benefit claims and HMRC support for taxi drivers across Northern Ireland.</p>
      </div>
      <div>
        <h4>Pages</h4>
        <a href="/about">About</a>
        <a href="/services">Services</a>
        <a href="/reviews">Reviews</a>
        <a href="/insights">Insights</a>
        <a href="/contact">Contact</a>
        <a href="/privacy">Privacy</a>
        <a href="/portal">Client portal</a>
      </div>
      <div>
        <h4>Popular services</h4>
        <a href="/services/self-assessment">Self Assessment</a>
        <a href="/services/making-tax-digital">Making Tax Digital</a>
        <a href="/services/hmrc-tax-check">HMRC tax checks</a>
        <a href="/services/benefit-claims">Benefit claims</a>
        <a href="/services/hmrc-investigations">HMRC investigations</a>
      </div>
      <div>
        <h4>Get in touch</h4>
        <a href="tel:07799414972">07799 414972 (Michael)</a>
        <a href="tel:07366565000">07366 565000 (Cathy)</a>
        <a href="tel:02890132083">02890 132083 (Office)</a>
        <a href="mailto:info@taxfortaxidrivers.co.uk">info@taxfortaxidrivers.co.uk</a>
        <p class="addr">Unit 4, North City Business Centre<br />2 Duncairn Gardens, Belfast BT15 2GG</p>
        <a href="/#refer">Refer a driver - £50</a>
        <a href="/portal">Sign in to portal</a>
      </div>
    </div>
    <div class="foot-bar">
      <span>&copy; {year} Tax for Taxi Drivers. All rights reserved. Belfast, Northern Ireland.</span>
      <span class="foot-legal">
        <a href="/privacy">Privacy Policy</a>
        <button type="button" class="cookie-prefs-link" id="open-cookie-prefs">Cookie preferences</button>
        <span class="credit">Built by <a href="https://yweb.co/" target="_blank" rel="noopener noreferrer"><b>yWeb</b></a></span>
      </span>
    </div>
  </div>
</footer>

<script>
  document.getElementById('open-cookie-prefs')?.addEventListener('click', () => {
    document.dispatchEvent(new Event('tft-open-cookie-prefs'));
  });
</script>

<style>
  .foot {
    background: #0b0a09;
    color: #b7b1a5;
    padding: 60px 0 26px;
  }

  .foot-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1.1fr 1.1fr;
    gap: 36px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .brand :global(img) {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
  }

  .brand-text b {
    display: block;
    color: #fff;
    font-size: 17px;
    letter-spacing: -0.01em;
  }

  .brand-text span {
    display: block;
    font-weight: 700;
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #8f897d;
  }

  .foot p {
    font-size: 14.5px;
    font-weight: 500;
    margin-top: 14px;
    max-width: 34ch;
  }

  .foot .addr {
    margin: 10px 0 6px;
    font-size: 13.5px;
    line-height: 1.45;
    color: #8f897d;
    max-width: 28ch;
  }

  .foot h4 {
    color: #fff;
    font-weight: 800;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 14px;
  }

  .foot a {
    display: block;
    color: #b7b1a5;
    font-size: 14.5px;
    font-weight: 500;
    padding: 4px 0;
    transition: color 0.2s;
  }

  .foot a:hover {
    color: var(--yellow);
  }

  .foot-bar {
    border-top: 1px solid #221f1b;
    margin-top: 44px;
    padding-top: 22px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    font-size: 13px;
  }

  .foot-legal {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .foot-legal a {
    display: inline;
    padding: 0;
    color: #8f897d;
    font-size: 13px;
  }

  .foot-legal a:hover {
    color: var(--yellow);
  }

  .cookie-prefs-link {
    background: none;
    border: none;
    padding: 0;
    color: #8f897d;
    font: inherit;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
  }

  .cookie-prefs-link:hover {
    color: var(--yellow);
  }

  .credit {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #8f897d;
    font-weight: 600;
  }

  .credit b,
  .credit a {
    color: var(--yellow);
    font-weight: 800;
  }

  .credit a:hover {
    color: #fff;
  }

  @media (max-width: 900px) {
    .foot-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 480px) {
    .foot-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
