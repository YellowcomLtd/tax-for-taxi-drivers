<section class="section uc">
  <div class="wrap uc-in">
    <div class="rv">
      <h3>Working 30+ hours a week? You may qualify for Universal Credit.</h3>
      <p>If you're a self-employed driver, you could be entitled, and we'd be delighted to help you claim it.</p>
    </div>
    <a class="rv btn btn-dark" href="tel:07366565000">Check my entitlement</a>
  </div>
</section>

<style>
  .uc {
    background: var(--yellow);
  }

  .uc-in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    flex-wrap: wrap;
  }

  .uc h3 {
    font-size: clamp(24px, 3.2vw, 36px);
    color: var(--ink);
    max-width: 20ch;
  }

  .uc p {
    color: #3d3626;
    font-weight: 600;
    max-width: 40ch;
    margin-top: 8px;
  }

  .uc .btn {
    padding: 16px 28px;
    font-size: 16px;
  }
</style>
