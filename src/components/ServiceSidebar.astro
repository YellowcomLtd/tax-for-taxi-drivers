---
import { getCollection } from 'astro:content';

interface Props {
  currentId: string;
  relatedServiceIds: string[];
  relatedInsightIds: string[];
}

const { currentId, relatedServiceIds, relatedInsightIds } = Astro.props;

const [allServices, allInsights] = await Promise.all([
  getCollection('services'),
  getCollection('insights', ({ data }) => !data.draft),
]);

const relatedServices = relatedServiceIds
  .map((id) => allServices.find((s) => s.id === id))
  .filter((s): s is NonNullable<typeof s> => Boolean(s));

const fallbackServices = allServices
  .filter((s) => s.id !== currentId && !relatedServiceIds.includes(s.id))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, Math.max(0, 5 - relatedServices.length));

const servicesToShow = [...relatedServices, ...fallbackServices].slice(0, 5);

const relatedInsights = relatedInsightIds
  .map((id) => allInsights.find((p) => p.id === id))
  .filter((p): p is NonNullable<typeof p> => Boolean(p))
  .slice(0, 4);

const moreServices = allServices
  .filter((s) => s.id !== currentId && !servicesToShow.some((shown) => shown.id === s.id))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);
---

<aside class="sidebar">
  <div class="sidebar-panel">
    <p class="sidebar-label">Related services</p>
    <ul class="link-list">
      {servicesToShow.map((item) => (
        <li>
          <a href={`/services/${item.id}`}>
            <span class="ico" aria-hidden="true">{item.data.icon}</span>
            <span class="text">
              <strong>{item.data.shortTitle}</strong>
              <span class="blurb">{item.data.cardText}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
    <a class="sidebar-all" href="/services">All services &amp; fees</a>
  </div>

  {relatedInsights.length > 0 && (
    <div class="sidebar-panel">
      <p class="sidebar-label">Related insights</p>
      <ul class="insight-list">
        {relatedInsights.map((post) => (
          <li>
            <a href={`/insights/${post.id}`}>{post.data.title}</a>
          </li>
        ))}
      </ul>
      <a class="sidebar-all" href="/insights">All insights</a>
    </div>
  )}

  {moreServices.length > 0 && (
    <div class="sidebar-panel muted">
      <p class="sidebar-label">Also available</p>
      <ul class="simple-list">
        {moreServices.map((item) => (
          <li>
            <a href={`/services/${item.id}`}>{item.data.shortTitle}</a>
          </li>
        ))}
      </ul>
    </div>
  )}

  <div class="sidebar-cta">
    <p class="sidebar-label">Need a hand?</p>
    <p class="cta-copy">Free, confidential chat - no obligation.</p>
    <a class="btn btn-y" href="tel:07799414972">Ring Michael</a>
    <a class="btn btn-ghost" href="/contact">Contact us</a>
  </div>
</aside>

<style>
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .sidebar-panel {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 20px 18px;
  }

  .sidebar-panel.muted {
    background: var(--paper-2);
  }

  .sidebar-label {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 14px;
  }

  .link-list,
  .insight-list,
  .simple-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .link-list a {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 12px;
    align-items: flex-start;
    padding: 10px 8px;
    border-radius: 12px;
    transition: background 0.15s ease;
  }

  .link-list a:hover {
    background: var(--yellow-soft);
  }

  .ico {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: var(--yellow-soft);
    border: 1px solid #f3e4a8;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    flex: none;
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .text strong {
    font-size: 14.5px;
    letter-spacing: -0.01em;
  }

  .blurb {
    font-size: 12.5px;
    color: var(--ink-2);
    font-weight: 500;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .insight-list a,
  .simple-list a {
    display: block;
    padding: 8px 0;
    font-weight: 700;
    font-size: 14px;
    line-height: 1.35;
    border-bottom: 1px solid var(--line);
  }

  .insight-list li:last-child a,
  .simple-list li:last-child a {
    border-bottom: none;
  }

  .insight-list a:hover,
  .simple-list a:hover {
    color: var(--ink);
    border-bottom-color: var(--yellow-deep);
  }

  .sidebar-all {
    display: inline-block;
    margin-top: 14px;
    font-weight: 800;
    font-size: 13px;
    border-bottom: 1.5px solid var(--yellow-deep);
  }

  .sidebar-cta {
    background: var(--ink);
    color: #fff;
    border-radius: 18px;
    padding: 22px 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .sidebar-cta .sidebar-label {
    color: var(--yellow);
    margin-bottom: 0;
  }

  .cta-copy {
    font-size: 14px;
    font-weight: 500;
    color: #c3bdb1;
    margin-bottom: 4px;
  }

  .sidebar-cta .btn {
    justify-content: center;
    width: 100%;
  }

  .sidebar-cta .btn-ghost {
    border-color: #4a4740;
    color: #fff;
  }

  .sidebar-cta .btn-ghost:hover {
    background: #fff;
    color: var(--ink);
    border-color: #fff;
  }

  @media (min-width: 981px) {
    .sidebar {
      position: sticky;
      top: 88px;
    }
  }
</style>
