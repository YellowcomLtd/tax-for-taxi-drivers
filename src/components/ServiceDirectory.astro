---
import { getCollection } from 'astro:content';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---

<ul class="dir">
  {services.map((service) => (
    <li class="rv">
      <a href={`/services/${service.id}`}>
        <span class="ico" aria-hidden="true">{service.data.icon}</span>
        <span class="text">
          <strong>{service.data.shortTitle}</strong>
          <span>{service.data.cardText}</span>
        </span>
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .dir {
    list-style: none;
    margin-top: 32px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .dir a {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 16px;
    align-items: center;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 18px 20px;
    transition: transform 0.18s ease, box-shadow 0.2s ease, border-color 0.2s;
  }

  .dir a:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow);
    border-color: #f3e4a8;
  }

  .ico {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--yellow-soft);
    border: 1px solid #f3e4a8;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .text strong {
    font-size: 16.5px;
    letter-spacing: -0.01em;
  }

  .text span {
    color: var(--ink-2);
    font-size: 14px;
    font-weight: 500;
  }

  .arrow {
    color: var(--ink-3);
    font-weight: 800;
    font-size: 18px;
  }
</style>
