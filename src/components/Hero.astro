---
import { Image } from 'astro:assets';
import heroPhoto from '../assets/images/office-consult-1.jpg';
---

<section class="hero">
  <div class="wrap hero-grid">
    <div class="rv">
      <h1>
        <span class="brand-line">Tax for Taxi Drivers</span>
        <span class="tagline">Tax Made Easy</span>
      </h1>
      <p class="subhead">Specialists in Tax Returns for the Self Employed for more than 10 years</p>
      <p class="lead">We prepare and submit your Self Assessment Tax Returns — minimise your tax liability and check your benefit entitlements.</p>
      <div class="hero-phones">
        <a href="tel:07799414972"><span>Michael</span><b>07799 414972</b></a>
        <a href="tel:07366565000"><span>Cathy</span><b>07366 565000</b></a>
        <a href="tel:02890132083"><span>Office</span><b>02890 132083</b></a>
      </div>
      <div class="hero-cta">
        <a class="btn btn-y" href="tel:07799414972">Ring Michael</a>
        <a class="btn btn-ghost" href="/services">See services &amp; fees</a>
      </div>
      <div class="trust"><span class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span> Trusted by hundreds of taxi drivers in N.Ireland — ask them.</div>
    </div>

    <div class="rv hero-photo">
      {/* Placeholder until Michael supplies the replacement hero photograph */}
      <Image src={heroPhoto} alt="Tax for Taxi Drivers team — replacement photograph pending from client" width={1000} height={1250} />
      <div class="hero-badge">
        <div class="hb-row"><span>Returns from</span><b>&pound;45/mo</b></div>
        <div class="hb-row"><span>First consultation</span><b>Free</b></div>
        <div class="hb-row"><span>Paid by</span><b>Direct debit</b></div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: 70px 0 40px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.12fr 0.88fr;
    gap: 54px;
    align-items: center;
  }

  .hero h1 {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .hero h1 .brand-line {
    display: block;
    font-size: clamp(36px, 5.2vw, 62px);
    letter-spacing: -0.02em;
    line-height: 1.02;
  }

  .hero h1 .tagline {
    display: inline-block;
    align-self: flex-start;
    font-size: clamp(22px, 3vw, 32px);
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--ink);
    background: linear-gradient(180deg, transparent 58%, var(--yellow) 58%);
    padding: 0 0.08em;
    line-height: 1.15;
  }

  .subhead {
    margin-top: 18px;
    font-size: 15px;
    font-weight: 700;
    color: var(--ink-2);
    max-width: 42ch;
    line-height: 1.45;
  }

  .hero p.lead {
    font-size: 18px;
    color: var(--ink-2);
    max-width: 38ch;
    margin-top: 14px;
    font-weight: 500;
  }

  .hero-phones {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 24px;
  }

  .hero-phones a {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-weight: 700;
  }

  .hero-phones span {
    min-width: 72px;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
    font-weight: 800;
  }

  .hero-phones b {
    font-size: 18px;
    color: var(--ink);
    border-bottom: 1.5px solid var(--yellow-deep);
  }

  .hero-phones a:hover b {
    color: var(--yellow-deep);
  }

  .hero-cta {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 26px;
  }

  .hero-cta .btn {
    padding: 15px 26px;
    font-size: 16px;
  }

  .trust {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 26px;
    color: var(--ink-2);
    font-weight: 600;
    font-size: 14.5px;
  }

  .stars {
    color: var(--yellow-deep);
    letter-spacing: 2px;
    font-size: 16px;
    flex: none;
  }

  .hero-photo {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow);
    border: 1px solid var(--line);
  }

  .hero-photo :global(img) {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .hero-badge {
    position: absolute;
    left: 18px;
    right: 18px;
    bottom: 18px;
    background: rgba(20, 19, 16, 0.82);
    backdrop-filter: blur(6px);
    border-radius: var(--radius-md);
    padding: 16px 18px;
    color: #fff;
  }

  .hb-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px 0;
    font-size: 13.5px;
    font-weight: 600;
    color: #d8d3c6;
  }

  .hb-row + .hb-row {
    border-top: 1px dashed rgba(255, 255, 255, 0.14);
  }

  .hb-row b {
    color: var(--yellow);
    font-weight: 800;
    font-size: 15px;
  }

  @media (max-width: 960px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .hero-photo :global(img) {
      aspect-ratio: 16 / 10;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding: 48px 0 28px;
    }

    .hero h1 .brand-line {
      font-size: clamp(30px, 9vw, 44px);
    }

    .hero-phones b {
      font-size: 16.5px;
    }
  }
</style>
