---
const plans = [
  { key: 'bronze', name: 'Bronze', price: 45 },
  { key: 'silver', name: 'Silver', price: 50, featured: true },
  { key: 'gold', name: 'Gold', price: 55 },
];

// Rows and tick data transcribed exactly from the client's supplied services/pricing grid.
const rows: { label: string; ticks: [boolean, boolean, boolean]; highlight?: boolean }[] = [
  { label: 'Register client for Self Assessment', ticks: [true, true, true] },
  { label: 'Register as a client with HMRC', ticks: [true, true, true] },
  { label: 'Supply an Income & Expenditure recording system', ticks: [true, true, true] },
  { label: 'Prepare a Self Assessment tax return for HMRC', ticks: [true, true, true] },
  { label: 'Prepare an Income & Expenditure account', ticks: [true, true, true] },
  { label: 'Submit a Self Assessment tax return to HMRC', ticks: [true, true, true] },
  { label: 'Supply a copy of HMRC tax return', ticks: [true, true, true] },
  { label: 'Supply a copy of the Income & Expenditure account', ticks: [true, true, true] },
  { label: 'Provide tax saving recommendations', ticks: [true, true, true] },
  { label: 'Complete a HMRC tax check', ticks: [false, true, true] },
  { label: 'Complete a pension forecast', ticks: [false, true, true] },
  { label: 'Loss of earning calculations', ticks: [false, true, true] },
  { label: 'Referrals to our Chartered Accountant', ticks: [false, true, true], highlight: true },
  { label: 'Making Tax Digital tax returns', ticks: [false, true, true], highlight: true },
  { label: 'Provide telephone support', ticks: [false, true, true], highlight: true },
  { label: 'Provide accountancy services for HMRC investigations', ticks: [false, false, true], highlight: true },
];

// Order matches the client's supplied list exactly (grouped by price, low to high).
const otherServices = [
  { label: 'Consultations', price: '£50', blurb: 'A dedicated one-to-one sit-down to talk through your specific tax question.', href: '/contact' },
  { label: 'Letters', price: '£50', blurb: 'Official correspondence drafted and sent to HMRC or another body on your behalf.' },
  { label: 'References', price: '£50', blurb: "A reference letter for a mortgage, tenancy or loan application." },
  { label: 'Passport verification', price: '£50', blurb: 'Identity document verification for an official application.' },
  { label: 'HMRC tax checks', price: '£50', blurb: 'The tax check now required before renewing your taxi licence.', href: '/services/hmrc-tax-check' },
  { label: 'Setup Government Gateway account', price: '£100', blurb: 'We create and configure your HMRC online account, ready to use.' },
  { label: 'State Pension forecast', price: '£150', blurb: 'A full check of your National Insurance record and what it means for your pension.', href: '/services/pensions-national-insurance' },
  { label: 'Loss of earnings calculations', price: '£150', blurb: 'A calculated figure for insurance, legal or compensation claims.', href: '/services/loss-of-earnings' },
  { label: 'Making Tax Digital', price: 'By arrangement', blurb: 'Getting your setup MTD-compliant, priced to how you actually work.', href: '/services/making-tax-digital' },
];
---

<div class="pricing-scroll">
  <table class="pricing">
    <thead>
      <tr>
        <th class="row-label"><span class="sr-only">Service</span></th>
        {plans.map((plan) => (
          <th class:list={[plan.featured && 'featured']}>
            {plan.featured && <span class="popular">Most popular</span>}
            <div class="pname">{plan.name}</div>
            <div class="price">&pound;{plan.price}<small>/mo</small></div>
            <div class="from">by Direct Debit</div>
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr class:list={[row.highlight && 'highlight']}>
          <th scope="row" class="row-label">{row.label}</th>
          {row.ticks.map((ticked, i) => (
            <td class:list={[plans[i].featured && 'featured']}>
              {ticked ? <span class="tick" aria-label="Included">&#10003;</span> : <span class="sr-only">Not included</span>}
            </td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>

<div class="other-services">
  <div class="head-row">
    <div>
      <span class="eyebrow">À la carte</span>
      <h3>Other services</h3>
    </div>
    <p>One-off jobs, priced individually, no plan required.</p>
  </div>
  <div class="other-grid">
    {otherServices.map((item) => (
      item.href ? (
        <a class="rv other-card" href={item.href}>
          <div class="body">
            <h4>{item.label}</h4>
            <p>{item.blurb}</p>
          </div>
          <div class="price-bar">
            <span class={item.price.startsWith('£') ? 'amount' : 'amount amount-text'}>{item.price}</span>
            {item.price.startsWith('£') && <span class="unit">one-off</span>}
          </div>
        </a>
      ) : (
        <div class="rv other-card">
          <div class="body">
            <h4>{item.label}</h4>
            <p>{item.blurb}</p>
          </div>
          <div class="price-bar">
            <span class={item.price.startsWith('£') ? 'amount' : 'amount amount-text'}>{item.price}</span>
            {item.price.startsWith('£') && <span class="unit">one-off</span>}
          </div>
        </div>
      )
    ))}
  </div>
  <p class="other-cta rv">Need one of these? Ring Michael on <a href="tel:07799414972">07799 414972</a> and we'll sort it.</p>
</div>

<p class="fees-note rv">All plans by direct debit. Remember, your accountancy fees are tax deductible.</p>

<style>
  .pricing-scroll {
    margin-top: 40px;
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--panel);
  }

  .pricing {
    width: 100%;
    min-width: 720px;
    border-collapse: collapse;
  }

  .pricing th,
  .pricing td {
    padding: 16px 18px;
    text-align: center;
    border-bottom: 1px solid var(--line);
  }

  .row-label {
    text-align: left;
    font-weight: 600;
    font-size: 14.5px;
    color: var(--ink);
    position: sticky;
    left: 0;
    background: var(--panel);
    min-width: 260px;
    z-index: 1;
  }

  thead .row-label {
    background: var(--panel);
  }

  thead th {
    position: relative;
    padding-top: 24px;
    min-width: 140px;
  }

  thead th.featured {
    background: var(--yellow-soft);
  }

  .popular {
    display: inline-block;
    background: var(--ink);
    color: var(--yellow);
    font-weight: 800;
    font-size: 10.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 5px 12px;
    border-radius: 999px;
    white-space: nowrap;
    margin-bottom: 10px;
  }

  .pname {
    font-weight: 800;
    font-size: 13px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .price {
    font-weight: 800;
    font-size: 30px;
    margin-top: 4px;
    line-height: 1;
  }

  .price small {
    font-size: 14px;
    color: var(--ink-2);
    font-weight: 700;
  }

  .from {
    font-weight: 600;
    font-size: 12px;
    color: var(--ink-2);
    margin-top: 4px;
  }

  tbody tr.highlight td,
  tbody tr.highlight .row-label {
    background: var(--yellow-soft);
  }

  tbody td.featured {
    background: rgba(255, 196, 0, 0.08);
  }

  tbody tr.highlight td.featured {
    background: rgba(255, 196, 0, 0.28);
  }

  tbody tr:last-child th,
  tbody tr:last-child td {
    border-bottom: none;
  }

  .tick {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #2fae4e;
    color: #fff;
    font-weight: 900;
    font-size: 13px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .other-services {
    margin-top: 64px;
  }

  .other-services .head-row {
    margin-bottom: 28px;
  }

  .other-services h3 {
    font-size: 24px;
    margin-top: 6px;
  }

  .other-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .other-card {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    color: inherit;
    text-decoration: none;
  }

  .other-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }

  .other-card .body {
    padding: 20px 22px 18px;
    flex: 1;
  }

  .other-card h4 {
    font-size: 17px;
    letter-spacing: -0.01em;
  }

  .other-card .body p {
    color: var(--ink-2);
    font-size: 13.5px;
    font-weight: 500;
    margin-top: 8px;
    line-height: 1.5;
  }

  .other-card .price-bar {
    background: var(--ink);
    color: var(--yellow);
    padding: 13px 22px;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
  }

  .other-card .amount {
    font-weight: 800;
    font-size: 19px;
  }

  .other-card .amount-text {
    font-size: 13.5px;
    letter-spacing: 0.01em;
  }

  .other-card .unit {
    font-size: 10.5px;
    color: #9c968a;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    white-space: nowrap;
  }

  .other-cta {
    text-align: center;
    margin-top: 28px;
    color: var(--ink-2);
    font-weight: 600;
    font-size: 14.5px;
  }

  .other-cta a {
    color: var(--ink);
    font-weight: 800;
    border-bottom: 1.5px solid var(--yellow-deep);
  }

  .fees-note {
    text-align: center;
    margin-top: 26px;
    color: var(--ink-2);
    font-weight: 600;
    font-size: 14.5px;
  }

  @media (max-width: 860px) {
    .other-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .other-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
