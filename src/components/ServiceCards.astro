---
import { getCollection } from 'astro:content';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;

const all = (await getCollection('services'))
  .filter((s) => s.data.card)
  .sort((a, b) => a.data.order - b.data.order);

const items = compact ? all.slice(0, 3) : all;
---

<div class="cards">
  {items.map((service) => (
    <a class="rv card" href={`/services/${service.id}`}>
      <div class="ico" aria-hidden="true">{service.data.icon}</div>
      <h3>{service.data.shortTitle}</h3>
      <p>{service.data.cardText}</p>
      <span class="more">Learn more</span>
    </a>
  ))}
</div>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 40px;
  }

  .card {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 26px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    display: flex;
    flex-direction: column;
  }

  .card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
  }

  .ico {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: var(--yellow-soft);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    border: 1px solid #f3e4a8;
  }

  .card h3 {
    font-size: 19px;
    margin: 18px 0 8px;
    letter-spacing: -0.01em;
  }

  .card p {
    color: var(--ink-2);
    font-size: 15px;
    font-weight: 500;
    flex: 1;
  }

  .more {
    margin-top: 14px;
    font-weight: 800;
    font-size: 13.5px;
    border-bottom: 1.5px solid var(--yellow-deep);
    align-self: flex-start;
  }

  @media (max-width: 960px) {
    .cards {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
