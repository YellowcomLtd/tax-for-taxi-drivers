---
import { getCollection } from 'astro:content';

interface Props {
  currentId: string;
  relatedServiceIds: string[];
  relatedInsightIds: string[];
}

const { currentId, relatedServiceIds, relatedInsightIds } = Astro.props;

const [allServices, allInsights] = await Promise.all([
  getCollection('services'),
  getCollection('insights', ({ data }) => !data.draft),
]);

const relatedServices = relatedServiceIds
  .map((id) => allServices.find((s) => s.id === id))
  .filter((s): s is NonNullable<typeof s> => Boolean(s));

const fallbackServices = allServices
  .filter((s) => s.id !== currentId && !relatedServiceIds.includes(s.id))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, Math.max(0, 3 - relatedServices.length));

const servicesToShow = [...relatedServices, ...fallbackServices].slice(0, 3);

const relatedInsights = relatedInsightIds
  .map((id) => allInsights.find((p) => p.id === id))
  .filter((p): p is NonNullable<typeof p> => Boolean(p))
  .slice(0, 3);
---

<section class="section related">
  <div class="wrap">
    <div class="head-row">
      <div class="rv">
        <span class="eyebrow">Related services</span>
        <h2 style="margin-top: 12px">Drivers often need these next.</h2>
      </div>
      <p class="rv"><a href="/services">View all services &amp; fees</a></p>
    </div>

    <div class="grid">
      {servicesToShow.map((item) => (
        <a class="rv card" href={`/services/${item.id}`}>
          <div class="ico" aria-hidden="true">{item.data.icon}</div>
          <h3>{item.data.shortTitle}</h3>
          <p>{item.data.cardText}</p>
          <span class="more">Read more</span>
        </a>
      ))}
    </div>

    {relatedInsights.length > 0 && (
      <div class="insights">
        <h3 class="rv">Related insights</h3>
        <ul>
          {relatedInsights.map((post) => (
            <li class="rv">
              <a href={`/insights/${post.id}`}>{post.data.title}</a>
            </li>
          ))}
        </ul>
      </div>
    )}

    <div class="rv quick-links">
      <a href="/contact">Contact us</a>
      <span aria-hidden="true">·</span>
      <a href="/#refer">Refer a driver — £50</a>
      <span aria-hidden="true">·</span>
      <a href="/reviews">Read reviews</a>
    </div>
  </div>
</section>

<style>
  .related {
    background: var(--paper);
  }

  .head-row a {
    font-weight: 800;
    border-bottom: 1.5px solid var(--yellow-deep);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin-top: 32px;
  }

  .card {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 24px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    display: flex;
    flex-direction: column;
  }

  .card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
  }

  .ico {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--yellow-soft);
    border: 1px solid #f3e4a8;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
  }

  .card h3 {
    font-size: 18px;
    margin: 16px 0 8px;
  }

  .card p {
    color: var(--ink-2);
    font-size: 14.5px;
    font-weight: 500;
    flex: 1;
  }

  .more {
    margin-top: 14px;
    font-weight: 800;
    font-size: 13.5px;
    color: var(--ink);
    border-bottom: 1.5px solid var(--yellow-deep);
    align-self: flex-start;
  }

  .insights {
    margin-top: 48px;
  }

  .insights h3 {
    font-size: 20px;
    margin-bottom: 14px;
  }

  .insights ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .insights a {
    font-weight: 700;
    font-size: 15.5px;
    border-bottom: 1.5px solid var(--yellow-deep);
  }

  .quick-links {
    margin-top: 36px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 14px;
    font-weight: 700;
    font-size: 14.5px;
    color: var(--ink-2);
  }

  .quick-links a {
    color: var(--ink);
    border-bottom: 1.5px solid var(--yellow-deep);
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
